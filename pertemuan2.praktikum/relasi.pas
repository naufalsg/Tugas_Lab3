program banding;
uses crt;

var
a, b : integer;

begin
    a := 15;
    b := 7;

    writeln('a=b: ', a = b);
    writeln('a <> b: ', a <> b);
    writeln ('a > b: ', a > b);
    writeln('a < b: ',  a < b);
    writeln('a >= b: ', a >= b);
    writeln('a <= n: ', a <= b);
    end.
    